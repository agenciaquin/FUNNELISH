# Proyecto quinchat
SUPABASE_URL=https://bjbjqmbuzpyjvcugbusx.supabase.co

# Clave service_role. NUNCA en el cliente, nunca commiteada.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket sobre el que trabaja la API
BUCKET=chat-media

# Puerto del servidor HTTP
PORT=8080

# Token compartido que exige la API en la cabecera x-api-token.
# Genera uno con: openssl rand -hex 32
API_TOKEN=

# --- Perfiles de calidad (opcionales, estos son los valores por defecto) ---
# Deliberadamente conservadores: preservan la resolucion original. El ahorro
# viene del cambio de formato (PNG/JPEG sobrecodificado -> WebP), no de recortar
# calidad. Ver el comentario de src/config.ts antes de bajarlos.
IMAGEN_ANCHO_MAX=1920
IMAGEN_CALIDAD=85
IMAGEN_MINIMO_BYTES=200000

VIDEO_ANCHO_MAX=1080
VIDEO_CRF=23
VIDEO_FPS_MAX=30
VIDEO_AUDIO_KBPS=128
VIDEO_MINIMO_BYTES=500000

# Cache de un ano para assets que no cambian
CACHE_CONTROL=31536000
