# =====================================================
# QUINCHAT — Variables de entorno
# Copia este archivo como .env.local y completa los valores
# NUNCA subas .env.local al repositorio
# =====================================================

# Claude API key (Anthropic)
# Obtenla en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) ID del tenant por defecto, para multi-tenant futuro
# QUINCHAT_DEFAULT_TENANT=agencia-quin

# (Opcional) Webhook secret para WhatsApp Cloud API (futuro)
# WHATSAPP_VERIFY_TOKEN=tu_token_aqui
# WHATSAPP_ACCESS_TOKEN=tu_access_token_aqui
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_id_aqui

# Catálogos de Klixmant desde el reporte (CONTRATO-API-CATALOGOS.md). Solo servidor: sin NEXT_PUBLIC_.
# REPORTE_API_URL=https://reporte-de-ventas-bwey.vercel.app
# QUINCHAT_API_KEY=la_misma_llave_que_en_el_reporte
